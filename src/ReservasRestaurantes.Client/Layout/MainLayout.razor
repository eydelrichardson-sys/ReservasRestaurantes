@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark rr-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="">
                <i class="bi bi-calendar2-check-fill"></i>
                <span>Reservas RD</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav"
                    aria-controls="menuNav" aria-expanded="false" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuNav">
                <div class="navbar-nav me-auto gap-1 mt-2 mt-lg-0">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><i class="bi bi-shop me-1"></i>Restaurantes</NavLink>
                    <NavLink class="nav-link" href="reserva"><i class="bi bi-search me-1"></i>Mi reserva</NavLink>

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <div class="nav-sep d-none d-lg-block"></div>
                            <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All"><i class="bi bi-speedometer2 me-1"></i>Dashboard</NavLink>
                            <NavLink class="nav-link" href="admin/mesas"><i class="bi bi-grid-3x3-gap me-1"></i>Mesas</NavLink>
                            <NavLink class="nav-link" href="admin/menu"><i class="bi bi-journal-richtext me-1"></i>Menú</NavLink>
                            <NavLink class="nav-link" href="admin/reportes"><i class="bi bi-bar-chart-line me-1"></i>Reportes</NavLink>
                            <NavLink class="nav-link" href="admin/perfil"><i class="bi bi-gear me-1"></i>Perfil y horarios</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    <AuthorizeView>
                        <Authorized>
                            <span class="text-white-50 small"><i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name</span>
                            <button class="btn btn-outline-light btn-sm" @onclick="Salir">
                                <i class="bi bi-box-arrow-right me-1"></i>Salir
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="btn btn-outline-light btn-sm" href="login">
                                <i class="bi bi-person-lock me-1"></i>Soy un restaurante
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @Body
    </main>

    <footer class="rr-footer py-4 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2 small">
            <span>© @DateTime.Now.Year Reservas RD · Sistema de reservas para restaurantes</span>
            <span>Hecho con .NET 8 · Blazor · SQL Server</span>
        </div>
    </footer>

</div>

@code {
    private async Task Salir()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("");
    }
}
