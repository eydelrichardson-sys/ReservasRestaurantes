@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · Reservas RD</PageTitle>

<div class="login-card">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="login-icon"><i class="bi bi-shop"></i></div>
            <h1 class="h3 text-center mb-1">Acceso para restaurantes</h1>
            <p class="text-muted text-center small mb-4">Gestiona tus mesas, horarios y reservas.</p>

            <EditForm Model="model" OnValidSubmit="Entrar">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <InputText class="form-control" type="email" @bind-Value="model.Email" autocomplete="username" />
                    <ValidationMessage For="() => model.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText class="form-control" type="password" @bind-Value="model.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => model.Password" />
                </div>

                @if (error != null)
                {
                    <div class="alert alert-danger py-2 small">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@error
                    </div>
                }

                <button class="btn btn-primary w-100 py-2" type="submit" disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Entrando…</span>
                    }
                    else
                    {
                        <span>Entrar</span>
                    }
                </button>
            </EditForm>

            <p class="text-center small mt-3 mb-0">¿Tu restaurante aún no está? <a href="registro">Regístralo aquí</a></p>

            <details class="mt-4 small text-muted">
                <summary>Cuentas de demostración</summary>
                <div class="mt-2">
                    admin&#64;lacasona.example<br />
                    admin&#64;marisqueria.example<br />
                    Contraseña: Admin123!
                </div>
            </details>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest model = new();
    private string? error;
    private bool cargando;

    private async Task Entrar()
    {
        cargando = true;
        error = await Auth.LoginAsync(model);
        cargando = false;

        if (error == null)
            Nav.NavigateTo("admin");
    }
}
