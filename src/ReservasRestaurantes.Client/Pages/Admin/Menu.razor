@page "/admin/menu"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api

<PageTitle>Menú</PageTitle>

<PageHeader Icon="bi-journal-richtext" Title="Menú del restaurante"
            Subtitle="Lo que publiques aquí lo ven los clientes en el perfil del restaurante." />

<Alerta @bind-Mensaje="mensaje" EsError="mensajeEsError" />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>@(model.Id == 0 ? "Nuevo plato" : "Editar plato")</h5>
                <EditForm Model="model" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label small mb-0">Nombre</label>
                        <InputText class="form-control" @bind-Value="model.Nombre" />
                        <ValidationMessage For="() => model.Nombre" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Categoría</label>
                        <InputText class="form-control" list="categorias" @bind-Value="model.Categoria" />
                        <datalist id="categorias">
                            @foreach (var c in categorias) { <option value="@c"></option> }
                        </datalist>
                        <ValidationMessage For="() => model.Categoria" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Descripción</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="model.Descripcion" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Precio (RD$)</label>
                        <InputNumber class="form-control" @bind-Value="model.Precio" />
                        <ValidationMessage For="() => model.Precio" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="disp" @bind-Value="model.Disponible" />
                        <label class="form-check-label" for="disp">Disponible (visible en el perfil)</label>
                    </div>
                    <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar</button>
                    @if (model.Id != 0)
                    {
                        <button class="btn btn-link" type="button" @onclick="Nuevo">Cancelar</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (cargando)
        {
            <Spinner />
        }
        else if (!items.Any())
        {
            <div class="alert alert-info">Todavía no hay platos en el menú.</div>
        }
        else
        {
            <table class="table align-middle bg-white">
                <thead class="table-light">
                    <tr><th>Plato</th><th>Categoría</th><th class="text-end">Precio</th><th></th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in items)
                    {
                        <tr class="@(m.Disponible ? "" : "text-muted")">
                            <td>@m.Nombre<div class="small text-muted">@m.Descripcion</div></td>
                            <td>@m.Categoria</td>
                            <td class="text-end text-nowrap">@m.Precio.ToString("N2")</td>
                            <td>@if (!m.Disponible) { <span class="badge bg-secondary">Oculto</span> }</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => Editar(m)">Editar</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(m)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<MenuItemDto> items = new();
    private MenuItemDto model = new();
    private bool cargando = true, guardando;
    private string? mensaje;
    private bool mensajeEsError;

    private IEnumerable<string> categorias =>
        items.Select(i => i.Categoria).Concat(new[] { "Entradas", "Platos principales", "Postres", "Bebidas" })
             .Distinct();

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        var res = await Api.GetAsync<List<MenuItemDto>>("api/admin/menu");
        if (res.Ok) items = res.Data ?? new();
        else Mostrar(res.Error ?? "No se pudo cargar el menú.", true);
        cargando = false;
    }

    private void Nuevo() => model = new MenuItemDto();

    private void Editar(MenuItemDto m) => model = new MenuItemDto
    {
        Id = m.Id, Nombre = m.Nombre, Descripcion = m.Descripcion,
        Precio = m.Precio, Categoria = m.Categoria, Disponible = m.Disponible
    };

    private async Task Guardar()
    {
        guardando = true;
        var res = model.Id == 0
            ? await Api.PostAsync("api/admin/menu", model)
            : await Api.PutAsync($"api/admin/menu/{model.Id}", model);
        guardando = false;

        if (res.Ok)
        {
            Mostrar("Plato guardado.", false);
            Nuevo();
            await Cargar();
        }
        else Mostrar(res.Error ?? "No se pudo guardar.", true);
    }

    private async Task Eliminar(MenuItemDto m)
    {
        var res = await Api.DeleteAsync($"api/admin/menu/{m.Id}");
        if (res.Ok)
        {
            Mostrar($"\"{m.Nombre}\" eliminado.", false);
            if (model.Id == m.Id) Nuevo();
            await Cargar();
        }
        else Mostrar(res.Error ?? "No se pudo eliminar.", true);
    }

    private void Mostrar(string texto, bool esError)
    {
        mensaje = texto;
        mensajeEsError = esError;
    }
}
