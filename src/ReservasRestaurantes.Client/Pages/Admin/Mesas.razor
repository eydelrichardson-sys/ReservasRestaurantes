@page "/admin/mesas"
@attribute [Authorize(Roles = "Admin")]
@inject ApiClient Api

<PageTitle>Mesas</PageTitle>

<PageHeader Icon="bi-grid-3x3-gap" Title="Mesas del restaurante"
            Subtitle="Define cuántas mesas hay y para cuántas personas. Solo las activas se pueden reservar." />

<Alerta @bind-Mensaje="mensaje" EsError="mensajeEsError" />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>@(model.Id == 0 ? "Nueva mesa" : $"Editar mesa {model.Numero}")</h5>
                <EditForm Model="model" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label small mb-0">Número</label>
                        <InputNumber class="form-control" @bind-Value="model.Numero" />
                        <ValidationMessage For="() => model.Numero" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0">Capacidad (personas)</label>
                        <InputNumber class="form-control" @bind-Value="model.Capacidad" />
                        <ValidationMessage For="() => model.Capacidad" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" id="activa" @bind-Value="model.Activa" />
                        <label class="form-check-label" for="activa">Activa (se puede reservar)</label>
                    </div>
                    <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar</button>
                    @if (model.Id != 0)
                    {
                        <button class="btn btn-link" type="button" @onclick="Nueva">Cancelar</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (cargando)
        {
            <Spinner />
        }
        else if (!mesas.Any())
        {
            <div class="alert alert-info">Aún no has registrado mesas. Sin mesas nadie puede reservar.</div>
        }
        else
        {
            <table class="table align-middle bg-white">
                <thead class="table-light">
                    <tr><th>Mesa</th><th>Capacidad</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in mesas)
                    {
                        <tr class="@(m.Activa ? "" : "text-muted")">
                            <td>@m.Numero</td>
                            <td>👥 @m.Capacidad</td>
                            <td>@(m.Activa ? "Activa" : "Inactiva")</td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => Editar(m)">Editar</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(m)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<MesaDto> mesas = new();
    private MesaDto model = new();
    private bool cargando = true, guardando;
    private string? mensaje;
    private bool mensajeEsError;

    protected override async Task OnInitializedAsync()
    {
        Nueva();
        await Cargar();
    }

    private async Task Cargar()
    {
        var res = await Api.GetAsync<List<MesaDto>>("api/admin/mesas");
        if (res.Ok) mesas = res.Data ?? new();
        else Mostrar(res.Error ?? "No se pudieron cargar las mesas.", true);
        cargando = false;
    }

    private void Nueva()
    {
        var siguiente = mesas.Any() ? mesas.Max(m => m.Numero) + 1 : 1;
        model = new MesaDto { Numero = siguiente, Capacidad = 4, Activa = true };
    }

    private void Editar(MesaDto m) =>
        model = new MesaDto { Id = m.Id, Numero = m.Numero, Capacidad = m.Capacidad, Activa = m.Activa };

    private async Task Guardar()
    {
        guardando = true;
        var res = model.Id == 0
            ? await Api.PostAsync("api/admin/mesas", model)
            : await Api.PutAsync($"api/admin/mesas/{model.Id}", model);
        guardando = false;

        if (res.Ok)
        {
            Mostrar("Mesa guardada.", false);
            await Cargar();
            Nueva();
        }
        else Mostrar(res.Error ?? "No se pudo guardar.", true);
    }

    private async Task Eliminar(MesaDto m)
    {
        var res = await Api.DeleteAsync($"api/admin/mesas/{m.Id}");
        if (res.Ok)
        {
            Mostrar($"Mesa {m.Numero} eliminada.", false);
            await Cargar();
            if (model.Id == m.Id) Nueva();
        }
        else Mostrar(res.Error ?? "No se pudo eliminar.", true);
    }

    private void Mostrar(string texto, bool esError)
    {
        mensaje = texto;
        mensajeEsError = esError;
    }
}
